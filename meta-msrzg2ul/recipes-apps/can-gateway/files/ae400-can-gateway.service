[Unit]
Description=AE400 CAN Gateway Service
After=network.target
Before=ae400-webserver.service

[Service]
Type=simple
ExecStart=/usr/bin/ae400
WorkingDirectory=/etc/ae400
Restart=always
RestartSec=5
User=root

# Give time for CAN interfaces to initialize
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
