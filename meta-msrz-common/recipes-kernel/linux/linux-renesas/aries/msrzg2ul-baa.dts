/*
 * Device Tree Source for the MSRZG2UL Single A55 OSM with AE400 Hardware Support
 * METHOD A: Direct merge into existing synthetic msrzg2ul-baa.dts
 *
 * Copyright (C) 2021 Renesas Electronics Corp.
 * Copyright (C) 2023 ARIES Embedded
 * AE400 Hardware integration: 2025
 */

/dts-v1/;
#include "../renesas/r9a07g043u.dtsi"
#include "msrzg2ul.dtsi"

/ {
	model = "ARIES MSRZ2GUL-BAA OSM with AE400 Hardware";
	compatible = "aries,msrz2gul-baa", "aries,msrz2gul", "renesas,r9a07g043u11", "renesas,r9a07g043";

	memory@48000000 {
		device_type = "memory";
		/* first 128MB is reserved for secure area. */
		reg = <0x0 0x48000000 0x0 0x38000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		global_cma: linux,cma@58000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0x58000000 0x0 0x08000000>;
		};
		//mmp_reserved: linux,multimedia {
		//	compatible = "shared-dma-pool";
		//	reusable;
		//	reg = <0x00000000 0x68000000 0x0 0x8000000>;
		//};
	};
		/* GPIO LED Configuration - P4_5 (PCB_RED_LED) */
		leds {
			compatible = "gpio-leds";
			status = "okay";

			led_red: led_red {
				label = "ae400:red:led";
				gpios = <&pinctrl 37 GPIO_ACTIVE_HIGH>;
				default-state = "off";
			};
		};


};

&ehci0 {
	memory-region = <&global_cma>;
};

&ohci0 {
	memory-region = <&global_cma>;
};

&ehci1 {
	memory-region = <&global_cma>;
};

&ohci1 {
	memory-region = <&global_cma>;
};


&pinctrl {
	sdhi0_pins: sd0 {
		sd0_data {
			pins = "SD0_DATA0", "SD0_DATA1", "SD0_DATA2", "SD0_DATA3",
			       "SD0_DATA4", "SD0_DATA5", "SD0_DATA6", "SD0_DATA7";
			power-source = <1800>;
		};

		sd0_ctrl {
			pins = "SD0_CLK", "SD0_CMD", "SD0_RST#";
			power-source = <1800>;
		};

		sd0_rst {
			pins = "SD0_RST#";
			power-source = <1800>;
		};
	};

	/* CAN Bus Pins */
	can0_pins: can0 {
		pinmux = <RZG2L_PORT_PINMUX(6, 2, 3)>,  /* CAN0_RX */
		         <RZG2L_PORT_PINMUX(13, 1, 3)>; /* CAN0_TX */
	};

	can1_pins: can1 {
		pinmux = <RZG2L_PORT_PINMUX(14, 1, 3)>, /* CAN1_RX */
		         <RZG2L_PORT_PINMUX(17, 0, 3)>; /* CAN1_TX */
	};

	/* Ethernet 0 Pins (RGMII) */
	eth0_pins: eth0 {
		pinmux = <RZG2L_PORT_PINMUX(1, 0, 1)>,  /* ET0_TXCLK */
		         <RZG2L_PORT_PINMUX(1, 1, 1)>,  /* ET0_TX_CTL */
		         <RZG2L_PORT_PINMUX(1, 2, 1)>,  /* ET0_TXD0 */
		         <RZG2L_PORT_PINMUX(1, 3, 1)>,  /* ET0_TXD1 */
		         <RZG2L_PORT_PINMUX(1, 4, 1)>,  /* ET0_TXD2 */
		         <RZG2L_PORT_PINMUX(2, 0, 1)>,  /* ET0_TXD3 */
		         <RZG2L_PORT_PINMUX(3, 0, 1)>,  /* ET0_RXCLK */
		         <RZG2L_PORT_PINMUX(3, 1, 1)>,  /* ET0_RX_CTL */
		         <RZG2L_PORT_PINMUX(3, 2, 1)>,  /* ET0_RXD0 */
		         <RZG2L_PORT_PINMUX(3, 3, 1)>,  /* ET0_RXD1 */
		         <RZG2L_PORT_PINMUX(4, 0, 1)>,  /* ET0_RXD2 */
		         <RZG2L_PORT_PINMUX(4, 1, 1)>,  /* ET0_RXD3 */
		         <RZG2L_PORT_PINMUX(4, 3, 1)>,  /* ET0_MDC */
		         <RZG2L_PORT_PINMUX(4, 4, 1)>;  /* ET0_MDIO */
	};

	/* Ethernet 1 Pins (RGMII) */
	eth1_pins: eth1 {
		pinmux = <RZG2L_PORT_PINMUX(7, 0, 1)>,  /* ET1_TXCLK */
		         <RZG2L_PORT_PINMUX(7, 1, 1)>,  /* ET1_TX_CTL */
		         <RZG2L_PORT_PINMUX(7, 2, 1)>,  /* ET1_TXD0 */
		         <RZG2L_PORT_PINMUX(7, 3, 1)>,  /* ET1_TXD1 */
		         <RZG2L_PORT_PINMUX(7, 4, 1)>,  /* ET1_TXD2 */
		         <RZG2L_PORT_PINMUX(8, 0, 1)>,  /* ET1_TXD3 */
		         <RZG2L_PORT_PINMUX(8, 4, 1)>,  /* ET1_RXCLK */
		         <RZG2L_PORT_PINMUX(9, 0, 1)>,  /* ET1_RX_CTL */
		         <RZG2L_PORT_PINMUX(9, 1, 1)>,  /* ET1_RXD0 */
		         <RZG2L_PORT_PINMUX(9, 2, 1)>,  /* ET1_RXD1 */
		         <RZG2L_PORT_PINMUX(9, 3, 1)>,  /* ET1_RXD2 */
		         <RZG2L_PORT_PINMUX(10, 0, 1)>, /* ET1_RXD3 */
		         <RZG2L_PORT_PINMUX(10, 2, 1)>, /* ET1_MDC */
		         <RZG2L_PORT_PINMUX(10, 3, 1)>; /* ET1_MDIO */
	};

	/* Audio Clock Input Pins - from external 12.288MHz oscillator */
	sound_clk_pins: sound_clk {
		pins = "AUDIO_CLK1", "AUDIO_CLK2";
		input-enable;
	};

	/* I2S/SSI Pins - Port 11 on RZ/G2UL */
	ssi0_pins: ssi0 {
		pinmux = <RZG2L_PORT_PINMUX(11, 0, 1)>, /* BCK */
		         <RZG2L_PORT_PINMUX(11, 1, 1)>, /* RCK/LRCLK */
		         <RZG2L_PORT_PINMUX(11, 2, 1)>, /* TXD (playback) */
		         <RZG2L_PORT_PINMUX(11, 3, 1)>; /* RXD (record) */
	};

	/* GPS UART Pins */
	sci1_pins: sci1 {
		pinmux = <RZG2L_PORT_PINMUX(18, 4, 6)>, /* TXD */
		         <RZG2L_PORT_PINMUX(18, 5, 6)>; /* RXD */
	};
};

&sdhi0 {
	pinctrl-0 = <&sdhi0_pins>;
	pinctrl-1 = <&sdhi0_pins>;
	pinctrl-names = "default", "state_uhs";

	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	bus-width = <8>;
	mmc-hs200-1_8v;
	non-removable;
	fixed-emmc-driver-type = <1>;
	status = "okay";
};

/* CAN Bus Configuration */
&canfd {
	pinctrl-0 = <&can0_pins &can1_pins>;
	pinctrl-names = "default";
	status = "okay";

	channel0 {
		status = "okay";
	};

	channel1 {
		status = "okay";
	};
};

/* Ethernet Configuration */
&eth0 {
	pinctrl-names = "default";
	pinctrl-0 = <&eth0_pins>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&eth1 {
	pinctrl-names = "default";
	pinctrl-0 = <&eth1_pins>;
	phy-mode = "rgmii-id";
	status = "okay";
};

/* I2S Audio Configuration */
&ssi0 {
	pinctrl-0 = <&ssi0_pins &sound_clk_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* GPS UART Configuration */
&sci1 {
	pinctrl-0 = <&sci1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* Disable Display Unit (no panel attached) to free conflicting pins */
&{/soc/display@10890000} {
	status = "disabled";
};

/* Simple Audio Card linking SSI0 to MAX98357A */
/ {
	sound: sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ae400-audio";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&dailink0_master>;
		simple-audio-card,frame-master = <&dailink0_master>;
		simple-audio-card,mclk-fs = <512>;  /* 24.576 MHz / 48000 Hz = 512 */

		/* DAPM widgets - define the external speaker endpoint */
		simple-audio-card,widgets =
			"Speaker", "Ext Spk";

		/* DAPM routing - connect codec output to external speaker */
		simple-audio-card,routing =
			"Ext Spk", "Speaker";

		dailink0_master: simple-audio-card,cpu {
			sound-dai = <&ssi0>;
		};

		simple-audio-card,codec {
			sound-dai = <&max98357a>;
		};
	};

	max98357a: max98357a {
		compatible = "maxim,max98357a";
		#sound-dai-cells = <0>;
		sdmode-gpios = <&pinctrl 41 GPIO_ACTIVE_HIGH>;
	};
};
