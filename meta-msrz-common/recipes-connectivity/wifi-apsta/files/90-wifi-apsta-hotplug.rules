ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="2870", RUN+="/etc/init.d/wifi-apsta hotplug-add"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="7612", RUN+="/etc/init.d/wifi-apsta hotplug-add"
ACTION=="remove", SUBSYSTEM=="usb", ENV{PRODUCT}=="e8d/7612/*", RUN+="/etc/init.d/wifi-apsta hotplug-remove"